{
    "name": "clayenkitten.dev",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.23.4"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "check": "astro check",
        "preview": "astro preview",
        "format": "prettier --write .",
        "astro": "astro"
    },
    "dependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "astro": "^7.4.12",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "prettier": "3.8.3",
        "prettier-plugin-astro": "0.14.1",
        "typescript": "^6.0.3"
    },
    "prettier": {
        "useTabs": false,
        "tabWidth": 4,
        "trailingComma": "all",
        "plugins": [
            "prettier-plugin-astro"
        ],
        "overrides": [
            {
                "files": "*.astro",
                "options": {
                    "parser": "astro"
                }
            }
        ]
    }
}
